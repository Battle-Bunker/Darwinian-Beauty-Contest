  "program": "turns",
  "docs": {
    "turns": {
      "doc": "One finished turn: a bee's challenge, a flower's response and the bee's decision.",
      "rows": null,
      "fields": {
        "game": {
          "doc": "the game's short id",
          "visibility": "public"
        },
        "seq": {
          "doc": "the number of the turn's feed or leave action (GET .../responses/:seq has its whole response)",
          "visibility": "public"
        },
        "round": {
          "doc": "the round the turn was taken in (1, 2, ...)",
          "visibility": "public"
        },
        "atMs": {
          "doc": "game time the round began: (round - 1) × round_ms",
          "visibility": "public"
        },
        "turn": {
          "doc": "the bee's turn number (1, 2, ...)",
          "visibility": "public"
        },
        "bee": {
          "doc": "the bee's team index",
          "visibility": "public"
        },
        "flower": {
          "doc": "the flower's team index",
          "visibility": "public"
        },
        "challenge": {
          "doc": "the bee's challenge",
          "visibility": "public"
        },
        "response": {
          "doc": "the flower's response (null if it failed, or if its JSON is over 4 KB: see responseBytes)",
          "visibility": "public"
        },
        "responseBytes": {
          "doc": "the response's size: UTF-8 bytes of its JSON text (null if it failed)",
          "visibility": "public"
        },
        "responseHash": {
          "doc": "an identifier of the full response; null unless the response is over 4 KB",
          "visibility": "public"
        },
        "fed": {
          "doc": "whether the bee fed",
          "visibility": "public"
        },
        "percent": {
          "doc": "the share of E the flower offered, 0-100 (null if it failed)",
          "visibility": "publicOnFeed"
        },
        "energy": {
          "doc": "E, the flower's excess energy (node·ms·bytes with the game's byte factor, else node·ms; 0 if it failed)",
          "visibility": "publicOnFeed"
        },
        "nectar": {
          "doc": "the nectar the flower gave the bee: percent/100 × E on a feed, else null",
          "visibility": "public"
        },
        "price": {
          "doc": "on a feed, the feed price the bee paid out of its nectar (0 in games without one), else null",
          "visibility": "public"
        },
        "net": {
          "doc": "on a feed, the bee's net nectar: nectar - price (it can be negative), else null",
          "visibility": "public"
        },
        "balance": {
          "doc": "on a feed in a pools game, the bee's nectar balance after it; else null",
          "visibility": "public"
        },
        "pollen": {
          "doc": "the pollen the flower gave the bee: (1 − percent/100) × E on a feed, else 0",
          "visibility": "public"
        },
        "ms": {
          "doc": "the flower's CPU time for the call (ms)",
          "visibility": "flower"
        },
        "budgetMs": {
          "doc": "R: the call's hidden time budget (ms of CPU time, uniform in minMs..ms): its hard limit, and E's ceiling",
          "visibility": "flower"
        },
        "flowerVersion": {
          "doc": "the flower version that answered",
          "visibility": "flower"
        },
        "flowerError": {
          "doc": "why the response is null (a timeout, an error, a malformed return); \"server fault: ...\" on a void turn",
          "visibility": "flower"
        },
        "beeMs": {
          "doc": "the bee's CPU time to decide (ms; null if it was late)",
          "visibility": "bee"
        },
        "beeVersion": {
          "doc": "the bee version that decided",
          "visibility": "bee"
        },
        "beeError": {
          "doc": "what went wrong with the bee's reply (late, a crash, a bad next challenge); \"server fault: ...\" on a void turn",
          "visibility": "bee"
        },
        "grain": {
          "doc": "on a feed, the pollen grain: ⌊scale × pollen^exponent⌋ characters (⌊0.1 × pollen^(1/3)⌋ by default) of the answering flower version's minified code, from a random start, wrapping",
          "visibility": "grain"
        },
        "grainVersion": {
          "doc": "the flower version the grain came from",
          "visibility": "grain"
        },
        "grainCodeLength": {
          "doc": "that version's minified code's length in characters",
          "visibility": "grain"
        }
      }
    },
    "versions": {
      "doc": "Every version of every program: when it went live, its size and what the change cost.",
      "rows": "team",
      "fields": {
        "game": {
          "doc": "the game's short id",
          "visibility": "public"
        },
        "team": {
          "doc": "the team's index",
          "visibility": "public"
        },
        "kind": {
          "doc": "flower or bee",
          "visibility": "public"
        },
        "version": {
          "doc": "1, 2, ... per team and kind",
          "visibility": "public"
        },
        "atMs": {
          "doc": "game time it went live (0: written in the lobby)",
          "visibility": "public"
        },
        "round": {
          "doc": "the first round it could play in: atMs ÷ round_ms + 1",
          "visibility": "public"
        },
        "size": {
          "doc": "its size in nodes",
          "visibility": "public"
        },
        "distance": {
          "doc": "node edits from the version before (null when written in the lobby)",
          "visibility": "public"
        },
        "cost": {
          "doc": "the change budget it cost (0 in the lobby)",
          "visibility": "public"
        },
        "problem": {
          "doc": "the first error it hit while playing",
          "visibility": "public"
        },
        "code": {
          "doc": "its source",
          "visibility": "code"
        }
      }
    },
    "teams": {
      "doc": "The teams playing, by index.",
      "rows": null,
      "fields": {
        "game": {
          "doc": "the game's short id",
          "visibility": "public"
        },
        "index": {
          "doc": "the team's index (GAME.team in its programs)",
          "visibility": "public"
        },
        "id": {
          "doc": "the team's id (as in actions and views)",
          "visibility": "public"
        },
        "name": {
          "doc": "the team's name",
          "visibility": "public"
        },
        "color": {
          "doc": "the team's colour",
          "visibility": "public"
        },
        "members": {
          "doc": "how many people are on the team",
          "visibility": "public"
        },
        "memory": {
          "doc": "the team's bee's MEMORY, as last saved",
          "visibility": "team"
        },
        "memoryBytes": {
          "doc": "its size: Σ over entries of the key's UTF-8 bytes + the value's JSON bytes",
          "visibility": "team"
        },
        "memoryVersion": {
          "doc": "the bee version it belongs to",
          "visibility": "team"
        },
        "memoryError": {
          "doc": "why its last save failed (over the cap, the wrong shape, fed() failed), if it did",
          "visibility": "team"
        }
      }
    },
    "pairs": {
      "doc": "The score ledgers, one row per (bee team, flower team): feeds, nectar and pollen over the whole game.",
      "rows": null,
      "fields": {
        "game": {
          "doc": "the game's short id",
          "visibility": "public"
        },
        "bee": {
          "doc": "the bee's team index",
          "visibility": "public"
        },
        "flower": {
          "doc": "the flower's team index",
          "visibility": "public"
        },
        "feeds": {
          "doc": "times this bee fed at this flower",
          "visibility": "public"
        },
        "nectar": {
          "doc": "nectar this bee got at this flower",
          "visibility": "public"
        },
        "pollen": {
          "doc": "the pollen this species gave this bee",
          "visibility": "public"
        }
      }
    },
    "prevalence": {
      "doc": "Prevalence on both sides (games that have it): every team's flower and bee success and draw chances, and its fitness so far, sampled about once a second of game time.",
      "rows": null,
      "fields": {
        "game": {
          "doc": "the game's short id",
          "visibility": "public"
        },
        "round": {
          "doc": "the round whose draws it gave (sampled as the round began)",
          "visibility": "public"
        },
        "atMs": {
          "doc": "game time that round began: (round - 1) × round_ms",
          "visibility": "public"
        },
        "team": {
          "doc": "the team's index (its species and its bee)",
          "visibility": "public"
        },
        "flowerSuccess": {
          "doc": "F_s: N × its species' share of recent pollination (Σ over bee teams of decayed pollen^beta), capped; par 1",
          "visibility": "public"
        },
        "beeSuccess": {
          "doc": "B_b: N × its bee's share of recent net nectar, capped; par 1 (pools: of its nectar balance; else of max(0, Σ over species of signed decayed (nectar - price)^alpha))",
          "visibility": "public"
        },
        "flowerP": {
          "doc": "p^F_s: the chance a visit is to its species, (c + F_s) / Σ (c + F_k)",
          "visibility": "public"
        },
        "beeP": {
          "doc": "p^B_b: its bee's share of the bee weights, (c + B_b) / Σ (c + B_k): the chance it fills a given slot first",
          "visibility": "public"
        },
        "fitness": {
          "doc": "its fitness at the sample, by the game's scoring.mode: \"final\", N² × p^F_s × p^B_s of that round; \"timeAverage\" (v2, v3), the time-average of F × B over the rounds played",
          "visibility": "public"
        },
        "balance": {
          "doc": "its bee's nectar balance at the sample (pools games), else null",
          "visibility": "public"
        },
        "c": {
          "doc": "c(t): the weight every species and bee has whatever its success: cStart × sech(k × t / cHalfS), k = arccosh 2, t in seconds of game time (cDecay \"sech\"); v2, v3 (\"linear\"): from cStart to cEnd over the game",
          "visibility": "public"
        },
        "slots": {
          "doc": "bees visiting each round: ceil(slots × N)",
          "visibility": "public"
        }
      }
    },
    "scores": {
      "doc": "The scoreboard: each team's fitness (the game's rule), pollination, forage and shares over the whole game, and its latest prevalence.",
      "rows": null,
      "fields": {
        "game": {
          "doc": "the game's short id",
          "visibility": "public"
        },
        "team": {
          "doc": "the team's index",
          "visibility": "public"
        },
        "pollination": {
          "doc": "Σ over bee teams of (pollen this species gave their bee)^beta (the game's scoring.beta; √ in games without one)",
          "visibility": "public"
        },
        "forage": {
          "doc": "Σ over flower teams of (nectar this bee got there)^alpha (the game's scoring.alpha; √ in games without one)",
          "visibility": "public"
        },
        "pollinationShare": {
